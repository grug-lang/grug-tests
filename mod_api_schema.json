{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "constraints": {
            "$ref": "#/definitions/constraintsObject"
        },
        "entities": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": [
                    "description"
                ],
                "additionalProperties": false,
                "properties": {
                    "description": {
                        "type": "string"
                    },
                    "static_methods": {
                        "$ref": "#/definitions/functionsObject"
                    },
                    "export_functions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "name",
                                "description"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "description": {
                                    "type": "string"
                                },
                                "parameters": {
                                    "$ref": "#/definitions/parametersArray"
                                }
                            }
                        }
                    }
                }
            }
        },
        "classes": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": [
                    "description"
                ],
                "additionalProperties": false,
                "properties": {
                    "description": {
                        "type": "string"
                    },
                    "used_generics": {
                        "$ref": "#/definitions/usedGenericsArray"
                    },
                    "static_methods": {
                        "$ref": "#/definitions/functionsObject"
                    },
                    "methods": {
                        "$ref": "#/definitions/functionsObject"
                    }
                }
            }
        },
        "host_functions": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": [
                    "description"
                ],
                "additionalProperties": false,
                "properties": {
                    "description": {
                        "type": "string"
                    },
                    "used_generics": {
                        "$ref": "#/definitions/usedGenericsArray"
                    },
                    "return_type": {
                        "$ref": "#/definitions/type"
                    },
                    "parameters": {
                        "$ref": "#/definitions/parametersArray"
                    }
                }
            }
        }
    },
    "definitions": {
        "constraintsObject": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/constraint"
            }
        },
        "constraint": {
            "type": "object",
            "required": [
                "description",
                "implementors"
            ],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "implementors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/constraintImplementor"
                    }
                }
            }
        },
        "constraintImplementor": {
            "type": "object",
            "required": [
                "type"
            ],
            "additionalProperties": false,
            "properties": {
                "used_generics": {
                    "$ref": "#/definitions/usedGenericsArray"
                },
                "type": {
                    "$ref": "#/definitions/type"
                }
            }
        },
        "usedGenericsArray": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/genericUsage"
            }
        },
        "genericUsage": {
            "type": "object",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "functionsObject": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": [
                    "description"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "used_generics": {
                        "$ref": "#/definitions/usedGenericsArray"
                    },
                    "description": {
                        "type": "string"
                    },
                    "parameters": {
                        "$ref": "#/definitions/parametersArray"
                    },
                    "return_type": {
                        "$ref": "#/definitions/type"
                    }
                }
            }
        },
        "parametersArray": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "type"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "type": {
                        "$ref": "#/definitions/type"
                    }
                }
            }
        },
        "type": {
            "type": "object",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "used_generics": {
                    "$ref": "#/definitions/usedGenericsArray"
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "generics": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/type"
                    }
                },
                "resource_extension": {
                    "type": "string"
                },
                "entity_type": {
                    "type": "string"
                }
            }
        }
    }
}