export a(x: number) {
    if x == 0 {
        cause_game_fn_error()
    } else if x == 1 {
        utils: Utils = utils()
        utils.cause_game_fn_error()
    } else if x == 2 {
        cause_game_fn_error_generic(true)
    } else if x == 3 {
        utils: Utils = utils()
        utils.cause_game_fn_error_generic("hello")
    } else {
        call_on_b_fn_number(x - 4)
    }
}

